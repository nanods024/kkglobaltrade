# Base URL of the backend API. In local dev, Vite's dev-server proxy
# (see vite.config.js) forwards /api and /uploads to the backend, so this
# can be left as a relative path. For production builds, point this at the
# deployed backend origin, e.g. https://api.kkglobaltrade.com
VITE_API_BASE_URL=/api

# WhatsApp number used by WhatsAppButton and RFQ "WhatsApp Enquiry" links
# (digits only, with country code, no + or spaces)
VITE_WHATSAPP_NUMBER=918500893054

VITE_COMPANY_EMAIL=kkglobaltrade1@gmail.com
VITE_COMPANY_PHONE=+91 8500893054
